/* ═══════════════════════════════════════════════════════════
   SELECT SERVER — Unity 6 UI Toolkit — Nivel AAA
   ═══════════════════════════════════════════════════════════ */

.select-server-root {
  flex-grow: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  min-height: 100%;
  position: relative;
}

#bg-image {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
}

#background {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  width: 100%; height: 100%;
  background-color: rgba(4, 6, 12, 0.55);
}

#particles-host {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
}

.particle-dot {
  position: absolute;
  border-radius: 3px;
  background-color: rgba(96, 165, 250, 0.35);
}

/* ── PANEL ── */
#panel {
  position: relative;
  flex-shrink: 0;
  width: 1100px;
  height: 650px;
  flex-direction: column;
  overflow: hidden;
  background-color: rgba(8, 12, 24, 0.82);
  border-top-width: 1px;
  border-top-color: rgba(59, 130, 246, 0.4);
  border-right-width: 1px;
  border-right-color: rgba(30, 37, 53, 0.8);
  border-bottom-width: 1px;
  border-bottom-color: rgba(30, 37, 53, 0.8);
  border-left-width: 1px;
  border-left-color: rgba(30, 37, 53, 0.8);
  border-radius: 4px;
  transition-property: opacity;
  transition-duration: 0.4s;
  transition-timing-function: ease-out;
}

/* Línea acento superior */
#top-accent-line {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background-image: linear-gradient(
    90deg,
    rgba(59, 130, 246, 0),
    rgba(59, 130, 246, 0.6),
    rgba(147, 197, 253, 1),
    rgba(59, 130, 246, 0.6),
    rgba(59, 130, 246, 0)
  );
}

/* Scanline animada */
#scanline {
  position: absolute;
  left: 0; right: 0;
  height: 2px;
  top: 0;
  background-image: linear-gradient(
    90deg,
    rgba(96, 165, 250, 0),
    rgba(96, 165, 250, 0.3),
    rgba(96, 165, 250, 0)
  );
  animation-name: scanline-move;
  animation-duration: 4s;
  animation-iteration-count: infinite;
  animation-timing-function: linear;
}

@keyframes scanline-move {
  from { translate: 0 -1080px; }
  to   { translate: 0 1080px;  }
}

/* Esquinas decorativas */
#corner-tl {
  position: absolute; top: 12px; left: 12px;
  width: 16px; height: 16px;
  border-top-width: 2px; border-left-width: 2px;
  border-top-color: rgba(59, 130, 246, 0.9);
  border-left-color: rgba(59, 130, 246, 0.9);
  border-right-width: 0; border-bottom-width: 0;
}
#corner-tr {
  position: absolute; top: 12px; right: 12px;
  width: 16px; height: 16px;
  border-top-width: 2px; border-right-width: 2px;
  border-top-color: rgba(59, 130, 246, 0.9);
  border-right-color: rgba(59, 130, 246, 0.9);
  border-left-width: 0; border-bottom-width: 0;
}
#corner-bl {
  position: absolute; bottom: 12px; left: 12px;
  width: 16px; height: 16px;
  border-bottom-width: 2px; border-left-width: 2px;
  border-bottom-color: rgba(59, 130, 246, 0.9);
  border-left-color: rgba(59, 130, 246, 0.9);
  border-right-width: 0; border-top-width: 0;
}
#corner-br {
  position: absolute; bottom: 12px; right: 12px;
  width: 16px; height: 16px;
  border-bottom-width: 2px; border-right-width: 2px;
  border-bottom-color: rgba(59, 130, 246, 0.9);
  border-right-color: rgba(59, 130, 246, 0.9);
  border-left-width: 0; border-top-width: 0;
}

/* ── HEADER ── */
#header {
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 16px 22px 14px;
  margin-top: 6px;
  border-bottom-width: 1px;
  border-bottom-color: rgba(30, 37, 53, 0.9);
  border-top-width: 0; border-right-width: 0; border-left-width: 0;
  background-color: rgba(15, 20, 40, 0.4);
}

#header-icon {
  width: 36px; height: 36px;
  margin-right: 12px;
  background-color: rgba(59, 130, 246, 0.15);
  border-radius: 6px;
  border-top-width: 2px; border-top-color: rgba(59, 130, 246, 0.9);
  border-right-width: 2px; border-right-color: rgba(59, 130, 246, 0.9);
  border-bottom-width: 2px; border-bottom-color: rgba(59, 130, 246, 0.9);
  border-left-width: 2px; border-left-color: rgba(59, 130, 246, 0.9);
  rotate: 45deg;
}

#header-left { flex-direction: row; align-items: center; }
#header-text { flex-direction: column; }

#title {
  font-size: 20px;
  color: #e2e8f0;
  letter-spacing: 3px;
  -unity-font-style: bold;
}

#subtitle {
  font-size: 10px;
  color: rgba(74, 85, 104, 0.9);
  letter-spacing: 2px;
  margin-top: 4px;
}

#close-btn {
  width: 38px; height: 34px;
  border-top-width: 1px; border-top-color: rgba(30, 37, 53, 0.8);
  border-right-width: 1px; border-right-color: rgba(30, 37, 53, 0.8);
  border-bottom-width: 1px; border-bottom-color: rgba(30, 37, 53, 0.8);
  border-left-width: 1px; border-left-color: rgba(30, 37, 53, 0.8);
  background-color: transparent;
  color: #64748b;
  font-size: 14px;
  -unity-text-align: middle-center;
}
#close-btn:hover {
  border-top-color: rgba(59, 130, 246, 0.8);
  border-right-color: rgba(59, 130, 246, 0.8);
  border-bottom-color: rgba(59, 130, 246, 0.8);
  border-left-color: rgba(59, 130, 246, 0.8);
  color: #60a5fa;
  background-color: rgba(59, 130, 246, 0.08);
}

/* ── BODY ── */
#body {
  flex-direction: row;
  flex-grow: 1;
  flex-shrink: 1;
  min-height: 0; min-width: 0;
}

/* ── SIDEBAR ── */
#sidebar {
  width: 160px;
  flex-shrink: 0;
  background-color: rgba(8, 11, 20, 0.7);
  border-right-width: 1px;
  border-right-color: rgba(30, 37, 53, 0.8);
  padding: 16px 12px;
  flex-direction: column;
}

#label-recent, #label-groups {
  font-size: 9px;
  letter-spacing: 2px;
  color: rgba(100, 116, 139, 0.8);
  margin-bottom: 8px;
  margin-left: 2px;
  -unity-font-style: bold;
}

#divider {
  height: 1px;
  background-color: rgba(30, 37, 53, 0.9);
  margin: 12px 0;
}

.sidebar-btn {
  margin-bottom: 6px;
  padding: 10px 12px;
  font-size: 11px;
  border-radius: 3px;
  border-top-width: 1px; border-top-color: rgba(26, 32, 48, 0.6);
  border-right-width: 1px; border-right-color: rgba(26, 32, 48, 0.6);
  border-bottom-width: 1px; border-bottom-color: rgba(26, 32, 48, 0.6);
  border-left-width: 1px; border-left-color: rgba(26, 32, 48, 0.6);
  color: rgba(75, 85, 99, 0.9);
  background-color: transparent;
  align-items: flex-start;
  -unity-font-style: bold;
}
.sidebar-btn:hover {
  border-top-color: rgba(42, 53, 85, 0.9);
  border-right-color: rgba(42, 53, 85, 0.9);
  border-bottom-color: rgba(42, 53, 85, 0.9);
  border-left-color: rgba(42, 53, 85, 0.9);
  color: #94a3b8;
  background-color: rgba(15, 25, 50, 0.5);
}
.sidebar-btn-active {
  border-top-color: rgba(37, 99, 235, 0.9) !important;
  border-right-color: rgba(37, 99, 235, 0.9) !important;
  border-bottom-color: rgba(37, 99, 235, 0.9) !important;
  border-left-color: rgba(37, 99, 235, 0.9) !important;
  background-color: rgba(15, 30, 56, 0.8) !important;
  color: #93c5fd !important;
}

/* ── MAIN ── */
#main {
  flex-grow: 1;
  flex-direction: column;
  min-width: 0; min-height: 0;
  padding: 12px 16px 0;
}

#legend {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 10px;
  padding-bottom: 10px;
  border-bottom-width: 1px;
  border-bottom-color: rgba(20, 24, 32, 0.9);
  border-top-width: 0; border-right-width: 0; border-left-width: 0;
}
.legend-row {
  flex-direction: row;
  align-items: center;
  margin-right: 18px;
  margin-bottom: 4px;
}
.legend-row > Label {
  font-size: 11px;
  color: #94a3b8;
}
.legend-dot {
  width: 10px; height: 10px;
  margin-right: 6px;
  border-radius: 5px;
}
.dot-green  { background-color: #22c55e; }
.dot-red    { background-color: #ef4444; }
.dot-yellow { background-color: #eab308; }
.dot-gray   { background-color: rgba(55, 65, 81, 0.8); }

.dot-pulse {
  animation-name: pulse-dot;
  animation-duration: 1.8s;
  animation-iteration-count: infinite;
  animation-timing-function: ease-in-out;
}
@keyframes pulse-dot {
  0%   { opacity: 1;    }
  50%  { opacity: 0.3;  }
  100% { opacity: 1;    }
}

#server-scroll { flex-grow: 1; min-height: 0; }

#server-grid {
  flex-direction: row;
  flex-wrap: wrap;
  align-content: flex-start;
  padding-bottom: 10px;
  transition-property: opacity;
  transition-duration: 0.2s;
}

/* ── SERVER CARDS ── */
.server-card {
  position: relative;
  width: 47%;
  flex-shrink: 0;
  min-height: 62px;
  flex-direction: row;
  align-items: flex-start;
  padding: 12px 14px;
  margin-right: 3%;
  margin-bottom: 10px;
  background-color: rgba(10, 14, 28, 0.75);
  border-radius: 3px;
  border-top-width: 1px; border-top-color: rgba(30, 37, 53, 0.7);
  border-right-width: 1px; border-right-color: rgba(30, 37, 53, 0.7);
  border-bottom-width: 1px; border-bottom-color: rgba(30, 37, 53, 0.7);
  border-left-width: 1px; border-left-color: rgba(30, 37, 53, 0.7);
  font-size: 12px;
  transition-property: border-top-color, border-right-color, border-bottom-color, border-left-color;
  transition-duration: 0.15s, 0.15s, 0.15s, 0.15s;
  transition-timing-function: ease, ease, ease, ease;
}
.server-card:hover {
  border-top-color: rgba(37, 99, 235, 0.9);
  border-right-color: rgba(37, 99, 235, 0.9);
  border-bottom-color: rgba(37, 99, 235, 0.9);
  border-left-color: rgba(37, 99, 235, 0.9);
  background-color: rgba(12, 20, 45, 0.85);
}
.server-card:hover > .card-left-bar {
  background-color: rgba(29, 78, 216, 0.8);
}
.server-card--maintenance { opacity: 0.3; }
.server-card.selected {
  border-top-color: rgba(59, 130, 246, 1);
  border-right-color: rgba(59, 130, 246, 1);
  border-bottom-color: rgba(59, 130, 246, 1);
  border-left-color: rgba(59, 130, 246, 1);
  background-color: rgba(10, 22, 48, 0.9);
}

.card-left-bar {
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 3px;
  background-color: transparent;
}
.server-card.selected > .card-left-bar {
  background-color: #3b82f6;
}

.server-card-inner {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: flex-start;
  flex-grow: 1;
  min-width: 0; width: 100%;
}
.card-dot {
  width: 10px; height: 10px;
  margin-right: 8px; margin-top: 3px;
  border-radius: 5px;
  flex-shrink: 0;
}
.server-card-name {
  flex-grow: 1; flex-shrink: 1;
  min-width: 80px;
  font-size: 12px;
  -unity-font-style: bold;
  color: #e2e8f0;
  white-space: normal;
  overflow: visible;
}
.server-card.selected .server-card-name { color: #93c5fd; }

.server-status-label {
  flex-basis: 100%; flex-shrink: 0;
  margin-left: 18px; margin-top: 4px;
  font-size: 11px; letter-spacing: 0.5px;
  white-space: normal;
}
.status-available   { color: #22c55e; }
.status-full        { color: #ef4444; }
.status-saturated   { color: #eab308; }
.status-maintenance { color: rgba(100, 116, 139, 0.7); }

/* ── BADGE NUEVO ── */
.badge-new-wrap {
  position: absolute; right: 8px; top: 6px;
  overflow: hidden; border-radius: 2px;
}
.badge-new-bg {
  background-color: rgba(37, 99, 235, 0.9);
  padding: 2px 7px;
}
.badge-new-text {
  font-size: 8px; color: #dbeafe;
  letter-spacing: 2px; -unity-font-style: bold;
}
.badge-shimmer-layer {
  position: absolute; left: 0; top: 0;
  width: 55%; height: 100%;
  background-image: linear-gradient(
    125deg,
    rgba(255,255,255,0) 20%,
    rgba(255,255,255,0.5) 50%,
    rgba(255,255,255,0) 80%
  );
  animation-name: shimmer-move;
  animation-duration: 2.5s;
  animation-iteration-count: infinite;
  animation-timing-function: linear;
}
.badge-shimmer-layer.shimmer-delay { animation-delay: 1.25s; }
@keyframes shimmer-move {
  0%   { translate: -80px 0; }
  100% { translate: 200px 0; }
}

/* ── FOOTER ── */
#footer {
  flex-shrink: 0;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 12px 22px;
  border-top-width: 1px;
  border-top-color: rgba(30, 37, 53, 0.9);
  background-color: rgba(8, 11, 20, 0.7);
}
#footer-text {
  flex-grow: 1; flex-shrink: 1;
  margin-right: 14px;
  font-size: 12px;
  color: rgba(148, 163, 184, 0.9);
  white-space: normal;
}
#connect-btn {
  flex-shrink: 0;
  padding: 10px 32px;
  font-size: 13px;
  -unity-font-style: bold;
  letter-spacing: 2px;
  border-top-width: 1px; border-top-color: rgba(29, 78, 216, 0.9);
  border-right-width: 1px; border-right-color: rgba(29, 78, 216, 0.9);
  border-bottom-width: 1px; border-bottom-color: rgba(29, 78, 216, 0.9);
  border-left-width: 1px; border-left-color: rgba(29, 78, 216, 0.9);
  background-color: rgba(15, 30, 56, 0.9);
  color: #60a5fa;
}
#connect-btn:hover {
  background-color: rgba(30, 58, 110, 0.95);
  border-top-color: rgba(59, 130, 246, 1);
  border-right-color: rgba(59, 130, 246, 1);
  border-bottom-color: rgba(59, 130, 246, 1);
  border-left-color: rgba(59, 130, 246, 1);
  color: #93c5fd;
}
#connect-btn:disabled { opacity: 0.25; }
