/* Select Server — Unity 6 · SelectServer.uxml
 * No tocar selectores internos del runtime (#unity-content-container, unity-scroll-*): pueden disparar asserts en RepaintPanels.
 */

.select-server-root {
  flex-grow: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  min-height: 100%;
  position: relative;
}

/* Imagen de fondo (launcher) detrás de partículas */
#bg-image {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

#background {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  background-color: #0a0c10;
}

#particles-host {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
}

.particle-dot {
  position: absolute;
  border-radius: 3px;
  background-color: rgba(96, 165, 250, 0.28);
}

/* FIX 2: panel fijo 900×560, sin position:absolute ni translate en el panel */
#panel {
  position: relative;
  flex-shrink: 0;
  width: 900px;
  height: 560px;
  flex-direction: column;
  overflow: hidden;
  background-color: #0f1219;
  border-top-width: 1px;
  border-top-color: #1e2535;
  border-right-width: 1px;
  border-right-color: #1e2535;
  border-bottom-width: 1px;
  border-bottom-color: #1e2535;
  border-left-width: 1px;
  border-left-color: #1e2535;
  border-radius: 2px;

  transition-property: opacity;
  transition-duration: 0.35s;
  transition-timing-function: ease-out;
}

#top-accent-line {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  background-image: linear-gradient(
    90deg,
    rgba(59, 130, 246, 0),
    rgba(59, 130, 246, 0.9),
    rgba(96, 165, 250, 1),
    rgba(59, 130, 246, 0.9),
    rgba(59, 130, 246, 0)
  );
}

#scanline {
  position: absolute;
  left: 0;
  right: 0;
  height: 3px;
  top: 0;
  background-image: linear-gradient(
    90deg,
    rgba(96, 165, 250, 0),
    rgba(96, 165, 250, 0.45),
    rgba(96, 165, 250, 0)
  );
  animation-name: scanline-move;
  animation-duration: 3.5s;
  animation-iteration-count: infinite;
  animation-timing-function: linear;
}

@keyframes scanline-move {
  from {
    translate: 0 -1080px;
  }
  to {
    translate: 0 1080px;
  }
}

#corner-tl {
  position: absolute;
  top: 10px;
  left: 10px;
  width: 14px;
  height: 14px;
  border-top-width: 2px;
  border-left-width: 2px;
  border-top-color: #3b82f6;
  border-left-color: #3b82f6;
  border-right-width: 0;
  border-bottom-width: 0;
}

#corner-tr {
  position: absolute;
  top: 10px;
  right: 10px;
  width: 14px;
  height: 14px;
  border-top-width: 2px;
  border-right-width: 2px;
  border-top-color: #3b82f6;
  border-right-color: #3b82f6;
  border-left-width: 0;
  border-bottom-width: 0;
}

#corner-bl {
  position: absolute;
  bottom: 10px;
  left: 10px;
  width: 14px;
  height: 14px;
  border-bottom-width: 2px;
  border-left-width: 2px;
  border-bottom-color: #3b82f6;
  border-left-color: #3b82f6;
  border-right-width: 0;
  border-top-width: 0;
}

#corner-br {
  position: absolute;
  bottom: 10px;
  right: 10px;
  width: 14px;
  height: 14px;
  border-bottom-width: 2px;
  border-right-width: 2px;
  border-bottom-color: #3b82f6;
  border-right-color: #3b82f6;
  border-left-width: 0;
  border-top-width: 0;
}

#header {
  flex-direction: row;
  align-items: flex-start;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 14px 18px 12px;
  margin-top: 6px;
  border-bottom-width: 1px;
  border-bottom-color: #1e2535;
  border-top-width: 0;
  border-right-width: 0;
  border-left-width: 0;
}

#header-icon {
  width: 32px;
  height: 32px;
  margin-right: 10px;
  background-color: rgba(59, 130, 246, 0.12);
  border-radius: 6px;
  border-top-width: 2px;
  border-top-color: #3b82f6;
  border-right-width: 2px;
  border-right-color: #3b82f6;
  border-bottom-width: 2px;
  border-bottom-color: #3b82f6;
  border-left-width: 2px;
  border-left-color: #3b82f6;
  rotate: 45deg;
}

#header-left {
  flex-direction: row;
  align-items: center;
}

#header-text {
  flex-direction: column;
}

#title {
  font-size: 18px;
  color: #e2e8f0;
  letter-spacing: 2px;
  -unity-font-style: bold;
}

#subtitle {
  font-size: 11px;
  color: #4a5568;
  letter-spacing: 1px;
  margin-top: 4px;
}

#close-btn {
  width: 36px;
  height: 32px;
  border-top-width: 1px;
  border-top-color: #1e2535;
  border-right-width: 1px;
  border-right-color: #1e2535;
  border-bottom-width: 1px;
  border-bottom-color: #1e2535;
  border-left-width: 1px;
  border-left-color: #1e2535;
  background-color: transparent;
  color: #94a3b8;
  font-size: 14px;
  -unity-text-align: middle-center;
}

#close-btn:hover {
  border-top-color: #3b82f6;
  border-right-color: #3b82f6;
  border-bottom-color: #3b82f6;
  border-left-color: #3b82f6;
  color: #60a5fa;
}

#body {
  flex-direction: row;
  flex-grow: 1;
  flex-shrink: 1;
  min-height: 0;
  min-width: 0;
}

#sidebar {
  width: 148px;
  flex-shrink: 0;
  background-color: #0c0f16;
  border-right-width: 1px;
  border-right-color: #1e2535;
  padding: 12px 10px;
  flex-direction: column;
}

#label-recent,
#label-groups {
  font-size: 9px;
  letter-spacing: 2px;
  color: #64748b;
  margin-bottom: 6px;
  margin-left: 2px;
  -unity-font-style: bold;
}

#divider {
  height: 1px;
  background-color: #1e2535;
  margin: 10px 0;
}

.sidebar-btn {
  margin-bottom: 6px;
  padding: 8px 10px;
  font-size: 11px;
  border-radius: 2px;
  border-top-width: 1px;
  border-top-color: #1a2030;
  border-right-width: 1px;
  border-right-color: #1a2030;
  border-bottom-width: 1px;
  border-bottom-color: #1a2030;
  border-left-width: 1px;
  border-left-color: #1a2030;
  color: #4b5563;
  background-color: transparent;
  align-items: flex-start;
  -unity-font-style: bold;
}

.sidebar-btn:hover {
  border-top-color: #2a3555;
  border-right-color: #2a3555;
  border-bottom-color: #2a3555;
  border-left-color: #2a3555;
  color: #94a3b8;
}

.sidebar-btn-active {
  border-top-color: #2563eb !important;
  border-right-color: #2563eb !important;
  border-bottom-color: #2563eb !important;
  border-left-color: #2563eb !important;
  background-color: #0f1e38 !important;
  color: #93c5fd !important;
}

#main {
  flex-grow: 1;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  padding: 10px 14px 0;
}

#legend {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 10px;
  padding-bottom: 8px;
  border-bottom-width: 1px;
  border-bottom-color: #141820;
  border-top-width: 0;
  border-right-width: 0;
  border-left-width: 0;
}

.legend-row {
  flex-direction: row;
  align-items: center;
  margin-right: 14px;
  margin-bottom: 4px;
}

.legend-row > Label {
  font-size: 11px;
  color: #94a3b8;
}

.legend-dot {
  width: 10px;
  height: 10px;
  margin-right: 6px;
  border-radius: 5px;
}

.dot-green {
  background-color: #22c55e;
}

.dot-red {
  background-color: #ef4444;
}

.dot-yellow {
  background-color: #eab308;
}

.dot-gray {
  background-color: #374151;
}

.dot-pulse {
  animation-name: pulse-dot;
  animation-duration: 1.8s;
  animation-iteration-count: infinite;
  animation-timing-function: ease-in-out;
}

@keyframes pulse-dot {
  0% {
    opacity: 1;
  }
  50% {
    opacity: 0.35;
  }
  100% {
    opacity: 1;
  }
}

#server-scroll {
  flex-grow: 1;
  min-height: 0;
}

#server-grid {
  flex-direction: row;
  flex-wrap: wrap;
  align-content: flex-start;
  padding-bottom: 10px;
  transition-property: opacity;
  transition-duration: 0.2s;
}

/* FIX 2: cards ~48% fila; sin column-gap/row-gap (USS más estable) */
.server-card {
  position: relative;
  width: 47%;
  flex-shrink: 0;
  min-height: 56px;
  flex-direction: row;
  align-items: flex-start;
  padding: 10px 12px;
  margin-right: 3%;
  margin-bottom: 8px;
  background-color: #0d1020;
  border-radius: 2px;
  border-top-width: 1px;
  border-top-color: #1e2535;
  border-right-width: 1px;
  border-right-color: #1e2535;
  border-bottom-width: 1px;
  border-bottom-color: #1e2535;
  border-left-width: 1px;
  border-left-color: #1e2535;
  font-size: 12px;

  /* Una duración por cada propiedad en transition-property (evita crash del StylePropertyReader en Unity 6). scale no va en transition aquí. */
  transition-property: border-top-color, border-right-color, border-bottom-color, border-left-color;
  transition-duration: 0.12s, 0.12s, 0.12s, 0.12s;
  transition-timing-function: ease, ease, ease, ease;
}

.server-card:hover {
  border-top-color: #2563eb;
  border-right-color: #2563eb;
  border-bottom-color: #2563eb;
  border-left-color: #2563eb;
}

.server-card:hover > .card-left-bar {
  background-color: #1d4ed8;
}

.server-card--maintenance {
  opacity: 0.35;
}

.server-card.selected {
  border-top-color: #3b82f6;
  border-right-color: #3b82f6;
  border-bottom-color: #3b82f6;
  border-left-color: #3b82f6;
  background-color: #0c1830;
}

.card-left-bar {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 3px;
  background-color: transparent;
}

.server-card.selected > .card-left-bar {
  background-color: #3b82f6;
}

.server-card-inner {
  flex-direction: row;
  flex-wrap: wrap;
  align-items: flex-start;
  flex-grow: 1;
  min-width: 0;
  width: 100%;
}

.card-dot {
  width: 10px;
  height: 10px;
  margin-right: 8px;
  margin-top: 3px;
  border-radius: 5px;
  flex-shrink: 0;
}

.server-card-name {
  flex-grow: 1;
  flex-shrink: 1;
  min-width: 80px;
  font-size: 12px;
  -unity-font-style: bold;
  color: #e2e8f0;
  white-space: normal;
  overflow: visible;
}

.server-card.selected .server-card-name {
  color: #93c5fd;
}

.server-status-label {
  flex-basis: 100%;
  flex-shrink: 0;
  margin-left: 18px;
  margin-top: 4px;
  font-size: 11px;
  letter-spacing: 0.5px;
  white-space: normal;
}

.status-available {
  color: #22c55e;
}

.status-full {
  color: #ef4444;
}

.status-saturated {
  color: #eab308;
}

.status-maintenance {
  color: #64748b;
}

.badge-new-wrap {
  position: absolute;
  right: 8px;
  top: 6px;
  overflow: hidden;
  border-radius: 2px;
}

.badge-new-bg {
  background-color: #2563eb;
  padding: 2px 7px;
}

.badge-new-text {
  font-size: 8px;
  color: #dbeafe;
  letter-spacing: 2px;
  -unity-font-style: bold;
}

.badge-shimmer-layer {
  position: absolute;
  left: 0;
  top: 0;
  width: 55%;
  height: 100%;
  background-image: linear-gradient(
    125deg,
    rgba(255, 255, 255, 0) 20%,
    rgba(255, 255, 255, 0.55) 50%,
    rgba(255, 255, 255, 0) 80%
  );
  animation-name: shimmer-move;
  animation-duration: 2.5s;
  animation-iteration-count: infinite;
  animation-timing-function: linear;
}

.badge-shimmer-layer.shimmer-delay {
  animation-delay: 1.25s;
}

@keyframes shimmer-move {
  0% {
    translate: -80px 0;
  }
  100% {
    translate: 200px 0;
  }
}

#footer {
  flex-shrink: 0;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 10px 18px;
  border-top-width: 1px;
  border-top-color: #1e2535;
  background-color: #0c0f16;
}

#footer-text {
  flex-grow: 1;
  flex-shrink: 1;
  margin-right: 12px;
  font-size: 12px;
  color: #94a3b8;
  white-space: normal;
}

#connect-btn {
  flex-shrink: 0;
  padding: 8px 24px;
  font-size: 13px;
  -unity-font-style: bold;
  letter-spacing: 2px;
  border-top-width: 1px;
  border-top-color: #1d4ed8;
  border-right-width: 1px;
  border-right-color: #1d4ed8;
  border-bottom-width: 1px;
  border-bottom-color: #1d4ed8;
  border-left-width: 1px;
  border-left-color: #1d4ed8;
  background-color: #0f1e38;
  color: #60a5fa;
}

#connect-btn:hover {
  background-color: #1e3a6e;
}

#connect-btn:disabled {
  opacity: 0.28;
}
